{
  "model": "deepseek-v4-pro",
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
    "ANTHROPIC_API_KEY": "your-api-key-here"
  },
  "permissions": {
    "allow": [
      "WebSearch(*)",
      "WebFetch(*)",
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "NotebookEdit(*)",
      "Task(*)",
      "Agent(*)",
      "Skill(*)",
      "Search(*)",
      "Grep(*)",
      "Glob(*)",
      "List(*)"
    ],
    "deny": []
  }
}
