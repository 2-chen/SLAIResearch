<%doc>
AAAI 2026 LaTeX Template (Jinja2) — based on official AAAI Press formatting instructions.
Requires: aaai2026.sty, aaai2026.bst (in same directory or texmf path)

Variables:
  title        — paper title (mixed case, NOT sentence case)
  authors      — list of {name: str}
  affiliations — list of str (one per line)
  abstract     — abstract text
  sections     — list of {heading: str, content: str}
  bibliography_file — .bib filename without extension (default: references)
<%doc>
\documentclass[letterpaper]{article} % DO NOT CHANGE THIS
\usepackage[submission]{aaai2026}  % DO NOT CHANGE THIS
\usepackage{times}  % DO NOT CHANGE THIS
\usepackage{helvet}  % DO NOT CHANGE THIS
\usepackage{courier}  % DO NOT CHANGE THIS
\usepackage[hyphens]{url}  % DO NOT CHANGE THIS
\usepackage{graphicx} % DO NOT CHANGE THIS
\urlstyle{rm} % DO NOT CHANGE THIS
\def\UrlFont{\rm}  % DO NOT CHANGE THIS
\usepackage{natbib}  % DO NOT CHANGE THIS AND DO NOT ADD ANY OPTIONS TO IT
\usepackage{caption} % DO NOT CHANGE THIS AND DO NOT ADD ANY OPTIONS TO IT
\usepackage{booktabs}
\usepackage{amsmath,amssymb,amsfonts}
\usepackage{bm}
\usepackage{subcaption}
\frenchspacing  % DO NOT CHANGE THIS
\setlength{\pdfpagewidth}{8.5in} % DO NOT CHANGE THIS
\setlength{\pdfpageheight}{11in} % DO NOT CHANGE THIS
\pdfinfo{/TemplateVersion (2026.1)}

\setcounter{secnumdepth}{0}

% ── Title (must be mixed case, not sentence case) ──
\title{<< title >>}

% ── Authors ──
\author{<< authors|map(attribute='name')|join(', ') >>}
\affiliations{
<<% for aff in affiliations %>>
    << aff >>
<<% endfor %>>
}

\begin{document}
\maketitle

\begin{abstract}
<< abstract >>
\end{abstract}

<<% for section in sections %>>
\section{<< section.heading >>}
<< section.content >>

<<% endfor %>>

\bibliography{<< bibliography_file | default('references') >>}

\end{document}
